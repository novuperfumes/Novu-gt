generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id              Int               @id @default(autoincrement())
  correo          String            @unique
  contrasenia     String
  rol             String            @default("CLIENTE")
  nombre          String
  apellido        String
  telefono        String?
  genero          String?
  sellos          Int               @default(0)
  carrito         CarritoMaestro?
  direcciones     Direccion[]
  favoritos       Favorito[]
  giftCards       GiftCard[]
  historialSellos HistorialSellos[]
  ordenes         OrdenCompra[]
  resenias        ReseniaPerfume[]
  usosPromocion   UsoPromocion[]
}

model GiftCard {
  id            Int           @id @default(autoincrement())
  id_usuario    Int
  codigo        String        @unique
  monto         Decimal       @db.Decimal(10, 2)
  activa        Boolean       @default(true)
  es_bienvenida Boolean       @default(false)
  usuario       Usuario       @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  ordenes       OrdenCompra[]
}

model Perfume {
  id             Int                   @id @default(autoincrement())
  nombre         String
  descripcion    String
  categoria      String
  tipo           String?
  genero         String?
  imagen         String
  galeria        String[]              @default([])
  marca          String
  activo         Boolean               @default(true)
  decant         Decant?
  favoritos      Favorito[]
  presentaciones PresentacionPerfume[]
  resenias       ReseniaPerfume[]
}

model PresentacionPerfume {
  id              Int                 @id @default(autoincrement())
  id_perfume      Int
  tamanio         String
  precio          Decimal             @db.Decimal(10, 2)
  stock           Int                 @default(0)
  costo           Decimal?            @default(0) @db.Decimal(10, 2)
  carritoDetalles CarritoDetalle[]
  ingresos        IngresoInventario[]
  ordenDetalles   OrdenDetalle[]
  perfume         Perfume             @relation(fields: [id_perfume], references: [id], onDelete: Cascade)
}

model CarritoMaestro {
  id         Int              @id @default(autoincrement())
  id_usuario Int              @unique
  detalles   CarritoDetalle[]
  usuario    Usuario          @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
}

model CarritoDetalle {
  id                 Int                  @id @default(autoincrement())
  id_carrito_maestro Int
  id_presentacion    Int?
  id_decant          Int?
  tipo_decant        String?
  cantidad           Int                  @default(1)
  carritoMaestro     CarritoMaestro       @relation(fields: [id_carrito_maestro], references: [id], onDelete: Cascade)
  decant             Decant?              @relation(fields: [id_decant], references: [id], onDelete: Cascade)
  presentacion       PresentacionPerfume? @relation(fields: [id_presentacion], references: [id], onDelete: Cascade)
}

model OrdenCompra {
  id                    Int               @id @default(autoincrement())
  id_usuario            Int
  fecha                 DateTime          @default(now())
  total                 Decimal           @db.Decimal(10, 2)
  estado                String            @default("PENDIENTE")
  metodo_de_pago        String
  tipo_entrega          String
  id_sucursal           Int?
  id_codigo_promocion   Int?
  nombre_recibe         String
  telefono_contacto     String
  direccion_entrega     String
  departamento_entrega  String
  municipio_entrega     String
  referencias_entrega   String?
  codigo_postal_entrega String?
  costo_envio           Decimal?          @default(0) @db.Decimal(10, 2)
  id_gift_card          Int?
  historialSellos       HistorialSellos[]
  codigoPromocion       CodigoPromocion?  @relation(fields: [id_codigo_promocion], references: [id])
  giftCard              GiftCard?         @relation(fields: [id_gift_card], references: [id])
  sucursal              Sucursal?         @relation(fields: [id_sucursal], references: [id])
  usuario               Usuario           @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  detalles              OrdenDetalle[]
}

model OrdenDetalle {
  id                       Int                       @id @default(autoincrement())
  id_orden                 Int
  id_presentacion          Int?
  id_decant                Int?
  tipo_decant              String?
  cantidad                 Int
  precio_unitario          Decimal                   @db.Decimal(10, 2)
  decant                   Decant?                   @relation(fields: [id_decant], references: [id], onDelete: Restrict)
  orden                    OrdenCompra               @relation(fields: [id_orden], references: [id], onDelete: Cascade)
  presentacion             PresentacionPerfume?      @relation(fields: [id_presentacion], references: [id], onDelete: Restrict)
  registroVentaAdmin       RegistroVentaAdmin?
  registroVentaDecantAdmin RegistroVentaDecantAdmin?
}

model Direccion {
  id            Int     @id @default(autoincrement())
  id_usuario    Int
  direccion     String
  departamento  String
  municipio     String
  referencias   String?
  codigo_postal String?
  usuario       Usuario @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
}

model Sucursal {
  id              Int           @id @default(autoincrement())
  nombre_sucursal String
  direccion       String
  departamento    String
  municipio       String
  telefono        String?
  ordenes         OrdenCompra[]
}

model CodigoPromocion {
  id             Int            @id @default(autoincrement())
  codigo         String         @unique
  tipo_descuento String
  descuento      Decimal        @db.Decimal(10, 2)
  fecha_inicio   DateTime
  fecha_fin      DateTime
  estado         String         @default("ACTIVO")
  ordenes        OrdenCompra[]
  usos           UsoPromocion[]
}

model UsoPromocion {
  id                  Int             @id @default(autoincrement())
  id_usuario          Int
  id_codigo_promocion Int
  fecha               DateTime        @default(now())
  codigoPromocion     CodigoPromocion @relation(fields: [id_codigo_promocion], references: [id], onDelete: Cascade)
  usuario             Usuario         @relation(fields: [id_usuario], references: [id], onDelete: Cascade)

  @@unique([id_usuario, id_codigo_promocion])
}

model MensajeContacto {
  id             Int      @id @default(autoincrement())
  nombre         String
  correo         String
  asunto         String
  mensaje        String
  fecha_creacion DateTime @default(now())
  leido          Boolean  @default(false)
}

model HistorialSellos {
  id              Int          @id @default(autoincrement())
  id_usuario      Int
  id_orden        Int?
  tipo_operacion  String
  cantidad_sellos Int
  fecha           DateTime     @default(now())
  orden           OrdenCompra? @relation(fields: [id_orden], references: [id])
  usuario         Usuario      @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
}

model ReseniaPerfume {
  id           Int      @id @default(autoincrement())
  id_usuario   Int
  id_perfume   Int
  calificacion Int
  comentario   String
  compra_label String?
  fecha        DateTime @default(now())
  perfume      Perfume  @relation(fields: [id_perfume], references: [id], onDelete: Cascade)
  usuario      Usuario  @relation(fields: [id_usuario], references: [id], onDelete: Cascade)

  @@unique([id_usuario, id_perfume])
}

model Favorito {
  id             Int      @id @default(autoincrement())
  id_usuario     Int
  id_perfume     Int
  fecha_agregado DateTime @default(now())
  perfume        Perfume  @relation(fields: [id_perfume], references: [id], onDelete: Cascade)
  usuario        Usuario  @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
}

model IngresoInventario {
  id              Int                 @id @default(autoincrement())
  id_presentacion Int
  fecha_ingreso   DateTime            @default(now())
  cantidad        Int
  costo_compra    Decimal             @db.Decimal(10, 2)
  tipo_traida     String
  costo_traida    Decimal             @db.Decimal(10, 2)
  costo_total     Decimal             @db.Decimal(10, 2)
  presentacion    PresentacionPerfume @relation(fields: [id_presentacion], references: [id], onDelete: Cascade)
}

model Decant {
  id              Int              @id @default(autoincrement())
  id_perfume      Int              @unique
  ml_origen       Int
  costo_original  Decimal          @db.Decimal(10, 2)
  precio_original Decimal          @db.Decimal(10, 2)
  costo_5ml       Decimal          @db.Decimal(10, 2)
  precio_5ml      Decimal          @db.Decimal(10, 2)
  stock_5ml       Int              @default(0)
  costo_10ml      Decimal          @db.Decimal(10, 2)
  precio_10ml     Decimal          @db.Decimal(10, 2)
  stock_10ml      Int              @default(0)
  carritoDetalles CarritoDetalle[]
  perfume         Perfume          @relation(fields: [id_perfume], references: [id], onDelete: Cascade)
  ordenDetalles   OrdenDetalle[]
}

model RegistroVentaAdmin {
  id                 Int           @id @default(autoincrement())
  id_orden_detalle   Int?          @unique
  fecha_venta        DateTime      @default(now())
  tipo               String?
  perfume            String
  genero             String?
  costo_compra       Decimal       @default(0) @db.Decimal(10, 2)
  costo_traida       Decimal       @default(0) @db.Decimal(10, 2)
  tipo_traida        String?
  costo_total        Decimal       @default(0) @db.Decimal(10, 2)
  costo_perfume      Decimal?      @db.Decimal(10, 2)
  costo              Decimal?      @db.Decimal(10, 2)
  pago               String?
  total_cliente      Decimal       @default(0) @db.Decimal(10, 2)
  total_recibido     Decimal?      @db.Decimal(10, 2)
  recibido_en_cuenta Decimal?      @db.Decimal(10, 2)
  entregado          Boolean       @default(false)
  envio_ce           String?
  total              Decimal?      @db.Decimal(10, 2)
  ordenDetalle       OrdenDetalle? @relation(fields: [id_orden_detalle], references: [id])
}

model RegistroVentaDecantAdmin {
  id                 Int           @id @default(autoincrement())
  id_orden_detalle   Int?          @unique
  fecha_venta        DateTime      @default(now())
  tipo               String?
  genero             String?
  ml_origen          Int?
  perfume            String
  costo_original     Decimal?      @db.Decimal(10, 2)
  costo_5ml          Decimal?      @db.Decimal(10, 2)
  costo_10ml         Decimal?      @db.Decimal(10, 2)
  precio_original    Decimal?      @db.Decimal(10, 2)
  precio_5ml         Decimal?      @db.Decimal(10, 2)
  precio_10ml        Decimal?      @db.Decimal(10, 2)
  tamano_vendido     String?
  pago               String?
  total_cliente      Decimal       @default(0) @db.Decimal(10, 2)
  total_recibido     Decimal?      @db.Decimal(10, 2)
  recibido_en_cuenta Decimal?      @db.Decimal(10, 2)
  entregado          Boolean       @default(false)
  envio_ce           String?
  total              Decimal?      @db.Decimal(10, 2)
  ordenDetalle       OrdenDetalle? @relation(fields: [id_orden_detalle], references: [id])
}

model OrdenWhatsApp {
  id             Int      @id @default(autoincrement())
  codigo         String   @unique @default(cuid())
  nombre_cliente String
  telefono       String
  direccion      String?
  nit            String?
  total          Decimal  @db.Decimal(10, 2)
  carrito_json   String
  estado         String   @default("PENDIENTE")
  fecha          DateTime @default(now())
}

model CampaniaDescuento {
  id           Int       @id @default(autoincrement())
  nombre       String
  activa       Boolean   @default(false)
  tipo         String
  descuento    Decimal   @db.Decimal(5, 2)
  categorias   String?
  perfume_ids  String?
  imagen       String?
  fecha_inicio DateTime?
  fecha_fin    DateTime?
  creado_en    DateTime  @default(now())
}
